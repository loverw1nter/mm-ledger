{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mm-ledger",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mm-ledger",
      "database_id": "c3c9d48a-1bd2-4e24-83e6-bf2b618ac120",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}